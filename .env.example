# Primary application storage: MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/scms_flood?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/scms_flood?retryWrites=true&w=majority
DB_NAME=scms_flood
SENSOR_DB_URL=

# Comma-separated allowed origins, or "*" for local development.
CORS_ORIGINS="*"

# Public base URL of the deployed app.
APP_URL=http://localhost:3000

# Secret used to sign session JWTs. Generate a fresh one per environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 bytes for HS256 (RFC 7518). Rotating this invalidates all sessions.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional Qdrant Cloud knowledge store for the disaster-intelligence chatbot.
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key
QDRANT_COLLECTION=flashflood_knowledge

# Optional validated Hugging Face flood-arrival model; otherwise hydraulic rollout is used.
# Install with scripts/download_arrival_model.py REPO_ID --revision COMMIT
TWIN_ARRIVAL_MODEL_DIR=

# Trained multi-hazard checkpoint produced by backend.ml.training.train.
# Validates weights, feature schema, scalers and a forward pass. JSON flags alone
# do not grant readiness. Synthetic training artifacts remain testing-only.
MULTI_HAZARD_MODEL_CHECKPOINT=
MULTI_HAZARD_DEVICE=cpu

# OpenWeatherMap API Key
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Twilio Emergency Telephony & SMS Broadcasting
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
